<%- include('parts/header') %>
<%- include('parts/navbar') %>
        <link rel="stylesheet" href="/chat.css">

<!-- <div class="container"> -->
    <div class="row">
        <input type="hidden" id="chatId" value="<%= chatId %>">
    <div class="col col-12 col-md-3">
        <img src="/<%=friendData.image %>" alt=""> <br>
        <a href="/profile/<%=friendData.id %>">
            <%=friendData.username %> 



        </a><br>
<button class="video-call-btn" id="callBtn">Video call</button>

    </div>
    <div class="col col-12 col-md-9 messages">
        <div  id="messages-container">
            <% for (let message of messages) { %>

    <div class="message <%= message.sender._id.toString() === isUser ? 'sent' : 'received' %>">
                <%= message.content %> <br>
            </div>


           <% } %>

        </div>


          

        <div class="message-form">
            <textarea id="message"></textarea>
            <button id="sendBtn">
                <!-- Send -->
                     <i class="bi bi-send-fill"></i>

            </button>
        </div>
        
       
    </div>
</div>

<!-- </div> -->



<%- include('parts/scripts') %>
<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/sockets/init.js"></script>
  <script src="/js/sockets/chat.js"></script>